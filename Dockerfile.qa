FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS qa

WORKDIR /app
ENV CI=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && ./node_modules/.bin/playwright install --with-deps chromium \
    && chown node:node /app

COPY --chown=node:node AGENTS.md eslint.config.mjs next.config.ts playwright.config.ts tsconfig.json ./
COPY --chown=node:node public ./public
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node src ./src
COPY --chown=node:node tests ./tests
USER node
CMD ["npm", "run", "gate:web"]
